#!/usr/bin/env bash
set -euo pipefail

umask 077

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
export DISPLAY="${DISPLAY:-:0}"

PROTON_DRIVE_BIN="${PROTON_DRIVE_BIN:-proton-drive}"
REMOTE="${1:-/my-files/recovery/secrets}"
STAMP="$(date -u '+%Y%m%dT%H%M%SZ')"
TMPDIR="$(mktemp -d)"
ARCHIVE="$TMPDIR/secrets-$STAMP.tar.gz"
LATEST_ARCHIVE="$TMPDIR/latest-secrets.tar.gz"
LOG="${XDG_RUNTIME_DIR:-/tmp}/backup-secrets-proton.log"
RUN_LOG="$TMPDIR/run.log"

notify_failure() {
  local status=$?
  local message="Proton secrets backup failed with exit $status. See $LOG"

  if [[ -f "$RUN_LOG" ]] && grep -q 'You need to login first' "$RUN_LOG"; then
    message="Proton Drive CLI is not signed in. Run 'proton-drive auth login' once. Backup was not uploaded."
  fi

  if command -v dunstify >/dev/null 2>&1; then
    dunstify -u critical "Secrets backup failed" "$message" || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -u critical "Secrets backup failed" "$message" || true
  fi

  exit "$status"
}

cleanup() {
  rm -rf "$TMPDIR"
}

ensure_remote_path() {
  local path="$1"
  local current="/my-files"
  local relative part
  local -a parts

  if [[ "$path" != "/my-files" && "$path" != /my-files/* ]]; then
    printf 'Remote path must be under /my-files: %s\n' "$path" >&2
    return 2
  fi

  relative="${path#/my-files}"
  relative="${relative#/}"
  IFS='/' read -r -a parts <<< "$relative"

  for part in "${parts[@]}"; do
    [[ -n "$part" ]] || continue
    if [[ "$part" == "." || "$part" == ".." ]]; then
      printf 'Remote path contains an invalid component: %s\n' "$part" >&2
      return 2
    fi
    if ! "$PROTON_DRIVE_BIN" filesystem info "$current/$part" >/dev/null 2>&1; then
      "$PROTON_DRIVE_BIN" filesystem create-folder "$current" "$part"
    fi
    current="$current/$part"
  done
}
trap cleanup EXIT
trap notify_failure ERR

exec > >(tee -a "$LOG" "$RUN_LOG") 2>&1

command -v "$PROTON_DRIVE_BIN" >/dev/null
tar -czf "$ARCHIVE" -C "$HOME" .secrets
ln "$ARCHIVE" "$LATEST_ARCHIVE"

ensure_remote_path "$REMOTE"
"$PROTON_DRIVE_BIN" filesystem upload \
  --conflict-strategy replace \
  --skip-thumbnails \
  "$ARCHIVE" "$LATEST_ARCHIVE" "$REMOTE"

echo "Uploaded $REMOTE/secrets-$STAMP.tar.gz"
echo "Updated $REMOTE/latest-secrets.tar.gz"
