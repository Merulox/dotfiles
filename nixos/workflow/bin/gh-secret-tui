#!/usr/bin/env python3
"""Interactive GitHub secrets manager backed by the official GitHub CLI."""

from __future__ import annotations

import argparse
import asyncio
import functools
import json
import os
import re
import subprocess
from dataclasses import dataclass, replace
from typing import Any, Callable, Coroutine, Sequence

from textual import on, work
from textual.app import App, ComposeResult
from textual.containers import Horizontal, Vertical, VerticalScroll
from textual.screen import ModalScreen
from textual.widgets import Button, DataTable, Footer, Header, Input, Label, Static


JSON_FIELDS = "name,updatedAt,visibility,numSelectedRepos,selectedReposURL"
SECRET_NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
Runner = Callable[..., subprocess.CompletedProcess[str]]


class GhSecretError(RuntimeError):
    """A safe-to-display failure from the GitHub CLI backend."""


@dataclass(frozen=True)
class SecretScope:
    kind: str = "repository"
    target: str = ""
    repo: str = ""
    app: str = "actions"

    def flags(self) -> list[str]:
        flags = ["--app", self.app]
        if self.kind == "repository":
            if self.target:
                flags.extend(["--repo", self.target])
        elif self.kind == "environment":
            flags.extend(["--env", self.target])
            if self.repo:
                flags.extend(["--repo", self.repo])
        elif self.kind == "organization":
            flags.extend(["--org", self.target])
        elif self.kind == "user":
            flags.append("--user")
        else:
            raise ValueError(f"Unknown secret scope: {self.kind}")
        return flags

    def label(self) -> str:
        if self.kind == "repository":
            location = self.target or "current repository"
        elif self.kind == "environment":
            location = f"{self.repo or 'current repository'} / {self.target or 'environment not selected'}"
        elif self.kind == "organization":
            location = self.target or "organization not selected"
        else:
            location = "current user"
        return f"{self.kind} · {location} · {self.app}"


class GhBackend:
    def __init__(self, gh: str = "gh", runner: Runner = subprocess.run) -> None:
        self.gh = gh
        self.runner = runner

    def _run(self, args: Sequence[str], *, secret_input: str | None = None) -> str:
        command = [self.gh, *args]
        completed = self.runner(
            command,
            input=secret_input,
            text=True,
            capture_output=True,
            check=False,
        )
        if completed.returncode:
            detail = (completed.stderr or completed.stdout or "GitHub CLI command failed").strip()
            raise GhSecretError(detail)
        return completed.stdout

    def current_repo(self) -> str:
        return self._run(["repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"]).strip()

    def list_secrets(self, scope: SecretScope) -> list[dict[str, Any]]:
        raw = self._run(["secret", "list", "--json", JSON_FIELDS, *scope.flags()])
        try:
            payload = json.loads(raw or "[]")
        except json.JSONDecodeError as exc:
            raise GhSecretError("GitHub CLI returned malformed secret metadata") from exc
        if not isinstance(payload, list):
            raise GhSecretError("GitHub CLI returned an unexpected secret list")
        return sorted(
            (item for item in payload if isinstance(item, dict) and isinstance(item.get("name"), str)),
            key=lambda item: item["name"].casefold(),
        )

    def selected_repositories(self, scope: SecretScope, secret: dict[str, Any]) -> str:
        url = secret.get("selectedReposURL")
        if not isinstance(url, str) or not url:
            if secret.get("numSelectedRepos"):
                raise GhSecretError("GitHub did not provide the selected-repository endpoint")
            return ""
        repository_field = "full_name" if scope.kind == "user" else "name"
        raw = self._run(["api", url, "--paginate", "--jq", f".repositories[].{repository_field}"])
        return ",".join(line.strip() for line in raw.splitlines() if line.strip())

    def set_secret(
        self,
        scope: SecretScope,
        name: str,
        value: str,
        *,
        visibility: str | None = None,
        repos: str | None = None,
    ) -> None:
        args = ["secret", "set", name, *scope.flags()]
        if visibility:
            args.extend(["--visibility", visibility])
        if repos:
            args.extend(["--repos", repos])
        self._run(args, secret_input=value)

    def delete_secret(self, scope: SecretScope, name: str) -> None:
        self._run(["secret", "delete", name, *scope.flags()])


def serialized_dialog(
    method: Callable[..., Coroutine[Any, Any, None]],
) -> Callable[..., Any]:
    """Run one modal flow at a time without cancelling an in-flight gh mutation."""

    @work(group="dialog")
    @functools.wraps(method)
    async def guarded(self: "GhSecretApp", *args: Any, **kwargs: Any) -> None:
        if self.dialog_busy:
            self.set_status("Finish or cancel the open dialog first")
            return
        self.dialog_busy = True
        try:
            await method(self, *args, **kwargs)
        finally:
            self.dialog_busy = False

    return guarded


class PromptModal(ModalScreen[str | None]):
    DEFAULT_CSS = """
    PromptModal { align: center middle; }
    PromptModal > Vertical { width: 68; height: auto; padding: 1 2; border: round $accent; background: $surface; }
    PromptModal Label { margin-bottom: 1; }
    PromptModal Input { margin-bottom: 1; }
    PromptModal Horizontal { height: auto; align: right middle; }
    PromptModal Button { margin-left: 1; }
    """

    def __init__(self, title: str, prompt: str, *, initial: str = "", password: bool = False) -> None:
        super().__init__()
        self.dialog_title = title
        self.prompt = prompt
        self.initial = initial
        self.password = password

    def compose(self) -> ComposeResult:
        with Vertical():
            yield Label(f"[b]{self.dialog_title}[/b]")
            yield Label(self.prompt)
            yield Input(value=self.initial, password=self.password, id="value")
            with Horizontal():
                yield Button("Cancel", id="cancel")
                yield Button("Continue", variant="primary", id="continue")

    def on_mount(self) -> None:
        self.query_one("#value", Input).focus()

    @on(Input.Submitted)
    def submitted(self, event: Input.Submitted) -> None:
        self.dismiss(event.value)

    @on(Button.Pressed)
    def button_pressed(self, event: Button.Pressed) -> None:
        if event.button.id == "continue":
            self.dismiss(self.query_one("#value", Input).value)
        else:
            self.dismiss(None)


class ChoiceModal(ModalScreen[str | None]):
    DEFAULT_CSS = """
    ChoiceModal { align: center middle; }
    ChoiceModal > VerticalScroll { width: 68; max-height: 80%; padding: 1 2; border: round $accent; background: $surface; }
    ChoiceModal Label { margin-bottom: 1; }
    ChoiceModal Button { width: 100%; margin-bottom: 1; }
    """

    def __init__(self, title: str, choices: Sequence[tuple[str, str]]) -> None:
        super().__init__()
        self.dialog_title = title
        self.choices = list(choices)

    def compose(self) -> ComposeResult:
        with VerticalScroll():
            yield Label(f"[b]{self.dialog_title}[/b]")
            for index, (label, _value) in enumerate(self.choices):
                yield Button(label, id=f"choice-{index}")
            yield Button("Cancel", id="cancel")

    def on_mount(self) -> None:
        buttons = self.query(Button)
        if buttons:
            buttons.first().focus()

    @on(Button.Pressed)
    def button_pressed(self, event: Button.Pressed) -> None:
        if event.button.id == "cancel":
            self.dismiss(None)
            return
        index = int((event.button.id or "").removeprefix("choice-"))
        self.dismiss(self.choices[index][1])


class GhSecretApp(App[None]):
    TITLE = "GitHub Secrets"
    SUB_TITLE = "values stay write-only and are sent to gh over stdin"
    CSS = """
    Screen { background: #090d12; }
    #context { height: 3; padding: 1 2; background: #111923; color: #76e3ea; }
    #secrets { height: 1fr; margin: 1 2; border: round #27445d; }
    #status { height: 3; padding: 1 2; background: #111923; color: #d3dce6; }
    DataTable > .datatable--cursor { background: #164e63; color: white; }
    """
    BINDINGS = [
        ("n", "new_secret", "Set"),
        ("e", "edit_secret", "Update"),
        ("d", "delete_secret", "Delete"),
        ("s", "scope", "Scope"),
        ("a", "application", "App"),
        ("r", "refresh", "Refresh"),
        ("q", "quit", "Quit"),
    ]

    def __init__(self, backend: GhBackend, scope: SecretScope) -> None:
        super().__init__()
        self.backend = backend
        self.scope = scope
        self.secrets: list[dict[str, Any]] = []
        self.dialog_busy = False

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        yield Static("", id="context", markup=False)
        yield DataTable(id="secrets", cursor_type="row", zebra_stripes=True)
        yield Static("Starting…", id="status", markup=False)
        yield Footer()

    async def on_mount(self) -> None:
        table = self.query_one("#secrets", DataTable)
        table.add_columns("Name", "Updated", "Visibility", "Repositories")
        if self.scope.kind in {"repository", "environment"} and not (self.scope.target or self.scope.repo):
            try:
                current = await asyncio.to_thread(self.backend.current_repo)
                self.scope = replace(
                    self.scope,
                    target=current if self.scope.kind == "repository" else self.scope.target,
                    repo=current if self.scope.kind == "environment" else self.scope.repo,
                )
            except GhSecretError:
                pass
        await self.refresh_secrets()

    def set_status(self, message: str) -> None:
        self.query_one("#status", Static).update(message)

    def update_context(self) -> None:
        self.query_one("#context", Static).update(self.scope.label())

    async def refresh_secrets(self) -> None:
        self.update_context()
        self.set_status("Loading secret metadata…")
        table = self.query_one("#secrets", DataTable)
        try:
            self.secrets = await asyncio.to_thread(self.backend.list_secrets, self.scope)
        except GhSecretError as exc:
            self.secrets = []
            table.clear()
            self.set_status(f"Error: {exc} · Press s to change scope")
            return
        table.clear()
        for item in self.secrets:
            updated = str(item.get("updatedAt") or "—").replace("T", " ").removesuffix("Z")
            visibility = str(item.get("visibility") or "—")
            selected = item.get("numSelectedRepos")
            repositories = str(selected) if selected is not None else "—"
            table.add_row(item["name"], updated, visibility, repositories, key=item["name"])
        count = len(self.secrets)
        self.set_status(f"{count} secret{'s' if count != 1 else ''} · values are never readable from GitHub")
        if count:
            table.focus()

    def selected_secret(self) -> dict[str, Any] | None:
        table = self.query_one("#secrets", DataTable)
        row = table.cursor_row
        if 0 <= row < len(self.secrets):
            return self.secrets[row]
        return None

    def action_refresh(self) -> None:
        self.run_worker(self.refresh_secrets(), exclusive=True, group="refresh")

    @serialized_dialog
    async def action_scope(self) -> None:
        kind = await self.push_screen_wait(ChoiceModal("Choose secret scope", [
            ("Repository", "repository"),
            ("Deployment environment", "environment"),
            ("Organization", "organization"),
            ("User Codespaces", "user"),
        ]))
        if kind is None:
            return
        if kind == "repository":
            current = self.scope.target if self.scope.kind == kind else ""
            if not current:
                try:
                    current = await asyncio.to_thread(self.backend.current_repo)
                except GhSecretError:
                    current = ""
            repo = await self.push_screen_wait(PromptModal("Repository", "OWNER/REPO", initial=current))
            if not repo:
                return
            self.scope = SecretScope(kind="repository", target=repo.strip(), app="actions")
        elif kind == "environment":
            current_repo = self.scope.repo if self.scope.kind == kind else ""
            if not current_repo:
                try:
                    current_repo = await asyncio.to_thread(self.backend.current_repo)
                except GhSecretError:
                    current_repo = ""
            repo = await self.push_screen_wait(PromptModal("Repository", "OWNER/REPO", initial=current_repo))
            if not repo:
                return
            environment = await self.push_screen_wait(PromptModal("Environment", "Deployment environment name"))
            if not environment:
                return
            self.scope = SecretScope(kind="environment", target=environment.strip(), repo=repo.strip(), app="actions")
        elif kind == "organization":
            initial = ""
            reference = self.scope.target if self.scope.kind == "repository" else self.scope.repo
            if reference and "/" in reference:
                initial = reference.split("/", 1)[0]
            organization = await self.push_screen_wait(PromptModal("Organization", "Organization login", initial=initial))
            if not organization:
                return
            self.scope = SecretScope(kind="organization", target=organization.strip(), app="actions")
        else:
            self.scope = SecretScope(kind="user", app="codespaces")
        await self.refresh_secrets()

    @serialized_dialog
    async def action_application(self) -> None:
        allowed = {
            "repository": [
                ("GitHub Actions", "actions"),
                ("GitHub Agents", "agents"),
                ("Codespaces", "codespaces"),
                ("Dependabot", "dependabot"),
            ],
            "environment": [("GitHub Actions", "actions")],
            "organization": [("GitHub Actions", "actions"), ("GitHub Agents", "agents"), ("Codespaces", "codespaces"), ("Dependabot", "dependabot")],
            "user": [("Codespaces", "codespaces")],
        }[self.scope.kind]
        application = await self.push_screen_wait(ChoiceModal("Choose application", allowed))
        if application is None:
            return
        self.scope = replace(self.scope, app=application)
        await self.refresh_secrets()

    async def _set_secret(self, initial_name: str = "", existing: dict[str, Any] | None = None) -> None:
        name = await self.push_screen_wait(PromptModal("Secret name", "Letters, numbers, and underscores", initial=initial_name))
        if name is None:
            return
        name = name.strip()
        if not SECRET_NAME.fullmatch(name):
            self.set_status("Secret names must start with a letter or underscore and contain only letters, numbers, or underscores")
            return
        value = await self.push_screen_wait(PromptModal(
            "Secret value",
            "The value is masked and passed to gh through stdin; GitHub never returns stored values",
            password=True,
        ))
        if value is None:
            return
        visibility: str | None = None
        repos: str | None = None
        if self.scope.kind == "organization":
            visibility = await self.push_screen_wait(ChoiceModal("Repository access", [
                ("Private repositories", "private"),
                ("All repositories", "all"),
                ("Selected repositories", "selected"),
            ]))
            if visibility is None:
                return
            if visibility == "selected":
                initial_repos = ""
                if existing is not None and existing.get("visibility") == "selected":
                    self.set_status(f"Loading repository access for {name}…")
                    try:
                        initial_repos = await asyncio.to_thread(
                            self.backend.selected_repositories,
                            self.scope,
                            existing,
                        )
                    except GhSecretError as exc:
                        self.set_status(f"Error: {exc}")
                        return
                repos = await self.push_screen_wait(PromptModal(
                    "Selected repositories",
                    "Comma-separated repository names",
                    initial=initial_repos,
                ))
                if not repos:
                    return
        elif self.scope.kind == "user":
            access = await self.push_screen_wait(ChoiceModal("Repository access", [
                ("All Codespaces repositories", "all"),
                ("Selected repositories", "selected"),
            ]))
            if access is None:
                return
            if access == "selected":
                initial_repos = ""
                if existing is not None and existing.get("numSelectedRepos"):
                    self.set_status(f"Loading repository access for {name}…")
                    try:
                        initial_repos = await asyncio.to_thread(
                            self.backend.selected_repositories,
                            self.scope,
                            existing,
                        )
                    except GhSecretError as exc:
                        self.set_status(f"Error: {exc}")
                        return
                repos = await self.push_screen_wait(PromptModal(
                    "Selected repositories",
                    "Comma-separated repository names",
                    initial=initial_repos,
                ))
                if not repos:
                    return
        self.set_status(f"Setting {name}…")
        try:
            await asyncio.to_thread(
                self.backend.set_secret,
                self.scope,
                name,
                value,
                visibility=visibility,
                repos=repos.strip() if repos else None,
            )
        except GhSecretError as exc:
            self.set_status(f"Error: {exc}")
            return
        await self.refresh_secrets()
        self.set_status(f"Set {name} · value remained write-only")

    @serialized_dialog
    async def action_new_secret(self) -> None:
        await self._set_secret()

    @serialized_dialog
    async def action_edit_secret(self) -> None:
        secret = self.selected_secret()
        if secret is None:
            self.set_status("Select a secret to update")
            return
        await self._set_secret(str(secret["name"]), existing=secret)

    @serialized_dialog
    async def action_delete_secret(self) -> None:
        secret = self.selected_secret()
        if secret is None:
            self.set_status("Select a secret to delete")
            return
        name = str(secret["name"])
        confirmed = await self.push_screen_wait(ChoiceModal(f"Delete {name}?", [
            ("Delete permanently", "yes"),
            ("Keep secret", "no"),
        ]))
        if confirmed != "yes":
            return
        self.set_status(f"Deleting {name}…")
        try:
            await asyncio.to_thread(self.backend.delete_secret, self.scope, name)
        except GhSecretError as exc:
            self.set_status(f"Error: {exc}")
            return
        await self.refresh_secrets()
        self.set_status(f"Deleted {name}")


def build_scope(args: argparse.Namespace) -> SecretScope:
    if args.user:
        return SecretScope(kind="user", app="codespaces")
    if args.org:
        return SecretScope(kind="organization", target=args.org, app=args.app)
    if args.env:
        return SecretScope(kind="environment", target=args.env, repo=args.repo or "", app="actions")
    return SecretScope(kind="repository", target=args.repo or "", app=args.app)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    scope = parser.add_mutually_exclusive_group()
    scope.add_argument("--org", help="start at an organization secret scope")
    scope.add_argument("--user", action="store_true", help="start at user Codespaces secrets")
    scope.add_argument("--env", help="start at a deployment environment")
    parser.add_argument("--repo", help="repository as OWNER/REPO")
    parser.add_argument("--app", choices=("actions", "agents", "codespaces", "dependabot"), default="actions")
    parser.add_argument("--gh", default=os.environ.get("GH_SECRET_TUI_GH", "gh"), help=argparse.SUPPRESS)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    GhSecretApp(GhBackend(args.gh), build_scope(args)).run()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
